# Template for keystore.properties (copy to keystore.properties and fill in real values).
# This file IS committed; the real keystore.properties is NOT.
#
# The signing configuration in app/build.gradle.kts reads these values when
# keystores/prism-dev.keystore exists. Keep the real keystore + this file backed up
# somewhere private: losing the key makes future builds uninstallable as in-place
# updates on phones that have the current key installed.
#
# See docs/APP_UPDATES.md for the full signing and update story.
storeFile=keystores/prism-dev.keystore
storePassword=REPLACE_ME
keyAlias=prismdev
keyPassword=REPLACE_ME
